<!-- Replace 192.0.2.10 with the host LAN address and 192.0.2.20 with the 3DS LAN address. -->
<CycloneDDS>
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface address="192.0.2.10" />
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>9</MaxAutoParticipantIndex>
      <Peers>
        <Peer Address="192.0.2.20" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>